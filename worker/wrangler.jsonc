{
  "name": "pdf-insight-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://yilyaa.github.io",
    "GEMINI_MODEL": "gemini-3.6-flash",
    "GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite",
    // The free Gemini tier answers in 10-25 s at busy times. The browser waits 45 s per request.
    "GEMINI_TIMEOUT_MS": "28000",
    "GEMINI_TOTAL_BUDGET_MS": "42000",
  },
}
